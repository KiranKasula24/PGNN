# Copy to .env for local runs. Keep the service-role key out of source control.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
# Server-to-server secret: Next.js sends this as X-GEOARGUS-INTERNAL-KEY.
PIGNN_INTERNAL_API_KEY=replace_with_a_long_random_secret
# Optional absolute path when geometry is mounted separately in a container.
PIGNN_MINE_GEOMETRY_PATH=/app/config/mine_geometry.json
# Required in production: mount or bake the trained artifact at this path.
PIGNN_CHECKPOINT=/app/checkpoints/pignn-0.1.1.pt
